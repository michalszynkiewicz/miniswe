# Dockerfile.benchmark — Isolated environment for running one benchmark variant.
#
# Each variant runs in its own container with:
#   - Fresh code checkout (no stale target/)
#   - miniswe binary from HEAD (pre-built)
#   - Cargo/Rust toolchain for validation (cargo check/build/test)
#   - No shared state between variants
#
# Build once:
#   docker build -f scripts/Dockerfile.benchmark -t miniswe-bench .
#
# The run-benchmark-docker.sh script handles per-variant containers.

FROM rust:1.89-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev git curl ca-certificates maven \
    && rm -rf /var/lib/apt/lists/*

# Pre-install rust-analyzer into miniswe's own cache, using the EXACT artifact
# miniswe would fetch at runtime (same GitHub releases/latest URL, same file).
# ensure_binary() returns it at the cache check, so no benchmark run touches
# the network for it. One run in 38 had this download fail at startup and spent
# the whole session with no LSP and no refactor tools; nothing in the results
# said so, and the 4/6 it produced was nearly reported as a model regression.
#
# Deliberately NOT `rustup component add rust-analyzer`: that installs the
# toolchain's own build — a different binary from the one every prior run used,
# which would quietly change LSP behaviour across the whole comparison set.
# The trailing --version is the real check: a broken pipe or truncated body
# would otherwise leave a corrupt file that looks like a valid cache entry.
RUN mkdir -p /root/.miniswe/lsp-servers \
    && curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-x86_64-unknown-linux-gnu.gz \
      | gunzip > /root/.miniswe/lsp-servers/rust-analyzer \
    && chmod +x /root/.miniswe/lsp-servers/rust-analyzer \
    && /root/.miniswe/lsp-servers/rust-analyzer --version

WORKDIR /build

# Copy source and build miniswe from HEAD
COPY . .
RUN cargo build --release

# Install miniswe binary
RUN cp /build/target/release/miniswe /usr/local/bin/miniswe

# Pre-download cargo registry (speeds up validation builds)
# but do NOT pre-build the benchmark target code
RUN cd /build && cargo fetch

# Keep the repo for git archive
RUN mkdir /repo && cp -r /build/.git /repo/.git

# Clean up build artifacts — each variant starts fresh
RUN rm -rf /build/target

WORKDIR /work
